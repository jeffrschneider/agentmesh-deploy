# `docker compose up -d` works with no .env at all, which is right for trying
# this on your own machine. It is NOT right for a mesh anyone else uses: the
# five variables under "Your mesh's own identity" below default to the
# AgentMesh hosted instance, and until you set them this deployment tells
# agents and people to go there. Copy this file to .env and set that block
# before you put this in front of anyone. Everything else is optional.

# Which images to run. Pin a version rather than tracking latest, so an
# unattended restart cannot change what you are running. All four AgentMesh
# images carry the same version and are released together.
AGENTMESH_VERSION=0.3.0

# The operator console login. Leave the password blank and the first start
# invents one and prints it in the services log:
#
#   docker compose logs services | grep -A6 "OPERATOR CONSOLE LOGIN"
#
# Only the scrypt hash is stored, so a generated password cannot be recovered
# later. To change either, delete operator-auth.json from the mesh-usage volume
# and restart. Twelve characters minimum if you set your own.
MESH_OPERATOR_ID=operator
MESH_OPERATOR_PASSWORD=

# ── Your mesh's own identity ─────────────────────────────────────────────────
#
# These five have defaults that point at the AgentMesh HOSTED instance, because
# that is where this code runs in production. Left unset, a mesh you start here
# calls itself agentmesh.ai, hands agents the hosted broker's addresses when
# they ask where to connect, and puts hosted-console links in outbound mail.
# Set them before anyone but you uses this deployment.

# What this mesh calls itself in credential responses.
MESH_NAME=

# Where agents are told to connect. This is the one that matters most: it is
# copied into credential responses, so a wrong value sends your agents to
# somebody else's broker. Use wss:// for the WebSocket once it is behind TLS.
MESH_NATS_ENDPOINTS=nats://localhost:4222,ws://localhost:4443

# The public base of the API. Sign-in links are built from it.
API_BASE_URL=http://localhost:3001

# The public base of the ACCOUNT console, which the api container serves on
# port 3001 on the same origin as the API. This is not the operator console on
# 8080; they are separate things. Outbound mail and the agent-linking URL are
# built from this, so an unset value invites your users to a console that is
# not yours.
MESH_CONSOLE_URL=http://localhost:3001

# Which origins may read the API from a browser, comma-separated. `*` is
# accepted for a deliberately open API.
MESH_CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# How the BROWSER reaches the api and the mesh. The defaults suit a local run.
# Serving the console to anyone else means real hostnames here, and https/wss,
# because an https page is not allowed to open a plain ws:// connection.
PUBLIC_API_URL=http://localhost:3001
PUBLIC_NATS_WS_URL=ws://localhost:4443

# How many sandbox credentials to mint on first run. Only read by the mint
# service; raising it later and running `docker compose up mint` mints the
# missing ones.
SANDBOX_POOL_SIZE=5

# Optional: a shared secret for calling the operator API without a browser. The
# console login is enough on its own; most deployments leave this alone.
MESH_OPERATOR_KEY=

# Optional: Postgres for the console's history charts. Unset means no history
# is recorded, and nothing else changes.
# METRICS_DB_URL=postgres://user:pass@host:5432/agentmesh

# Sign-in mail. Unset, the bundle runs in dev mode and sign-in links print in
# the services log (your own log, on a single-host mesh). For real email, set
# a Resend key and declare the deployment production; the image then refuses
# to start if the key ever goes missing, rather than print links silently.
# RESEND_API_KEY=
# NODE_ENV=production

# ── The A2A bridge ───────────────────────────────────────────────────────────
#
# THE DEFAULT IS A BRIDGE THAT REFUSES EVERY INBOUND CALL. With no API keys and
# anonymous access off, the bridge starts, prints a warning saying exactly this,
# and answers 401 to every A2A caller. It does no mesh work on anyone's behalf
# until you choose one of the two lines below.
#
# That is deliberate rather than an oversight. A caller admitted by this bridge
# gets a node-vouched mesh identity, so an open bridge is something an operator
# turns on knowing it, never something a deployment bundle hands them.
#
# The outbound direction is unaffected: the eval agent is attached and appears
# on the mesh regardless of what is set here. These variables govern who may
# call IN.

# Comma-separated key=label pairs. Each key is a bearer token a caller sends as
# `Authorization: Bearer <key>`, and each label is how that caller appears in
# the bridge's log. A caller presenting a key gets a stable mesh identity and
# its own rate budget, which is what makes one noisy client throttleable without
# touching the rest. Generate them, do not invent them: `openssl rand -hex 24`.
BRIDGE_API_KEYS=

# The other way in: admit callers presenting NO credentials at all. Only `1`,
# `true`, `yes` or `on` turn it on; anything unrecognised is treated as off and
# says so, so a typo cannot quietly open the bridge. Do this knowingly — any
# caller that can reach port 8090 then gets a mesh identity, and GET /agents
# will enumerate every publicly discoverable agent to them.
BRIDGE_ALLOW_ANONYMOUS=

# Whose X-Forwarded-For header may be believed: IPs, CIDRs, or the literal
# `loopback` for 127.0.0.0/8 and ::1. Empty means believe nobody, and callers
# are identified by socket address — correct for the published port above.
#
# Behind a reverse proxy, GETTING THIS WRONG COLLAPSES EVERY CALLER INTO ONE
# IDENTITY: the proxy's. They then share a single rate bucket and are
# indistinguishable in the log. Set it to the proxy's address, and never widen
# it to "believe the header from anyone" — a caller who can write the header
# could otherwise mint a fresh identity, and a fresh budget, per request. An
# entry that does not parse stops the bridge at startup rather than silently
# moving the trust boundary.
BRIDGE_TRUSTED_PROXIES=

# Inbound requests per minute, per caller identity.
BRIDGE_RATE_PER_MINUTE=30

# The address a remote A2A client reaches this bridge on. It is copied verbatim
# into every agent card the bridge generates, so it is the address clients come
# back to; a real hostname once anything outside this host uses it.
PUBLIC_BRIDGE_URL=http://localhost:8090

# The eval agent's own inbound cap, per client address. It enforces this itself
# rather than relying on the bridge, because the bridge's outbound limiter is
# per-attachment and does not cover a second bridge or a curl loop.
EVAL_AGENT_RATE_PER_MINUTE=60

# Both services are published on the host: the bridge on 8090 and the eval agent
# on 8091. The eval agent's port is published so that a failing validation step
# can be split in one command — call the agent directly, and if it answers, the
# fault is the bridge. Change the left-hand side of the port mappings in
# docker-compose.yml if either collides with something you already run.
